          "overall_sentiment": {
            "$ref": "#/components/schemas/SentimentScore"
          },
          "aspects": {
            "items": {
              "$ref": "#/components/schemas/AspectDetail"
            },
            "type": "array",
            "title": "Aspects"
          },
          "key_phrases": {
            "items": {
              "type": "string"
            },
            "type": "array",
