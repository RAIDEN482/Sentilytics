      "SentimentScore": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "positive_score": {
            "type": "number",
            "title": "Positive Score"
          },
          "neutral_score": {
            "type": "number",
            "title": "Neutral Score"
          },
          "negative_score": {
            "type": "number",
            "title": "Negative Score"
          },
          "compound_score": {
            "type": "number",
            "title": "Compound Score"
          }
        },
        "type": "object",
        "required": [
          "label",
          "positive_score",
          "neutral_score",
          "negative_score",
          "compound_score"
