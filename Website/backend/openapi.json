  "components": {
    "schemas": {
      "AnalysisResultResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "row_index": {
            "type": "integer",
            "title": "Row Index"
          },
          "raw_text": {
            "type": "string",
            "title": "Raw Text"
          },
          "compound_score": {
            "type": "number",
            "title": "Compound Score"
          },
          "positive_score": {
            "type": "number",
            "title": "Positive Score"
          },
          "neutral_score": {
            "type": "number",
            "title": "Neutral Score"
          },
          "negative_score": {
            "type": "number",
            "title": "Negative Score"
          },
          "overall_sentiment": {
            "type": "string",
            "title": "Overall Sentiment"
          },
          "aspects": {
            "items": {
              "$ref": "#/components/schemas/AspectDetail"
            },
            "type": "array",
            "title": "Aspects"
          },
          "key_phrases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Key Phrases"
          }
        },
        "type": "object",
        "required": [
          "id",
          "job_id",
          "row_index",
          "raw_text",
          "compound_score",
          "positive_score",
          "neutral_score",
          "negative_score",
          "overall_sentiment",
          "aspects",
          "key_phrases"
        ],
        "title": "AnalysisResultResponse"
      },
      "AnalyzeMetadata": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "processing_time_ms": {
            "type": "integer",
            "title": "Processing Time Ms"
          },
          "llm_used": {
            "type": "boolean",
            "title": "Llm Used"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "processing_time_ms",
          "llm_used"
        ],
        "title": "AnalyzeMetadata"
      },
      "AnalyzeOptions": {
        "properties": {
          "include_aspects": {
            "type": "boolean",
            "title": "Include Aspects",
            "default": true
          },
          "include_key_phrases": {
            "type": "boolean",
            "title": "Include Key Phrases",
            "default": true
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "title": "AnalyzeOptions"
      },
      "AnalyzeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalyzeOptions"
              },
              {
                "type": "null"
              }
            ],
            "default": {
              "include_aspects": true,
              "include_key_phrases": true,
              "language": "en"
            }
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
